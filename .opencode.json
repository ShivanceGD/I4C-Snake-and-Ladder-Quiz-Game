{
  "$schema": "https://opencode.ai/config.json",
  "mcpServers": {
    "UnityMCP": {
      "command": "uvx",
      "args": ["--from", "mcpforunityserver", "mcp-for-unity"],
      "type": "stdio"
    },
    "Graphify": {
      "command": "python",
      "args": ["-m", "graphify.serve", "graphify-out/graph.json"],
      "type": "stdio"
    }
  },
  "contextPaths": [
    "CLAUDE.md",
    "AGENTS.md",
    ".cursor/rules/context-guidelines.mdc",
    ".cursor/rules/unity-project.mdc",
    "graphify-out/GRAPH_REPORT.md"
  ],
  "agent": {
    "default": {
      "tools": {
        "Graphify*": true
      }
    }
  }
}
